# session-local voice QA scratch (scan intermediates, decoded wavs)
.voicebuild/

# Generated art intermediates. Every slot PNG the image pipeline writes is
# resized to a served JPEG and then deleted, so a PNG in here only ever means
# "a batch is still running". The two reference sheets are INPUTS to the
# generator, not output, and stay tracked.
spellbound-app/books/art/*.png
!spellbound-app/books/art/bizzy-sheet.png
!spellbound-app/books/art/vex-sheet.png
spellbound-app/app-art/*.png

# Book PDFs are generated from the HTML on demand; the HTML is the book.
spellbound-app/books/pdf/
__pycache__/

# Video source images: downloaded archive originals (Library of Congress, NPG,
# Smithsonian). Single files run to 27MB and a full episode's research is
# hundreds of MB — this is exactly the bloat that cost this repo a 1.63GB
# history purge, and the rule from that is to gitignore BEFORE the first commit.
# MANIFEST.md is the durable artifact: it records every source URL and rights
# statement, so the binaries are re-downloadable and the provenance is not lost.
video/images/*
!video/images/MANIFEST.md
video/vo/full/
video/vo/sec-*.mp3
video/segs.json
video/film/out/
video/out/
