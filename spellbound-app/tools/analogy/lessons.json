{
  "_note": "The Analogy Trail's lessons, stems and seed rows. DRAFT — written for review, not yet approved by a person. Every word must be a Bee headword (build-app.cjs drops and reports any that is not). Stems are the A : B pairs a child sees first; they are chosen from here only, never from the engine. Seed rows are relation rows the definitions cannot supply (everyday opposites, degree ladders, parts, materials, uses, doers); the engine builds their wrong answers.",
  "lessons": [
    {
      "id": "same", "rels": ["synonym"], "title": "Same meaning", "ic": "link",
      "idea": "Some words are near twins: they mean almost the same thing. Big and large. Quick and fast.",
      "bridge": "{A} means about the same as {B}.",
      "spot": "Swap one word for the other in a sentence. If the sentence still means the same, they are twins.",
      "trap": "Watch for a word that goes WITH the word but does not MEAN it. Cool and breeze go together, but a breeze is not cool.",
      "stems": [["big", "large"], ["quick", "fast"], ["begin", "start"], ["shout", "yell"], ["gift", "present"], ["angry", "mad"], ["choose", "pick"], ["close", "shut"], ["huge", "giant"], ["simple", "easy"]]
    },
    {
      "id": "opposite", "rels": ["antonym"], "title": "Opposites", "ic": "swap",
      "idea": "Opposites sit at the two ends of the same line. Hot and cold are both about temperature, at opposite ends.",
      "bridge": "{A} is the opposite of {B}.",
      "spot": "Ask: are they about the same thing, at opposite ends? Full and empty are both about how much is inside.",
      "trap": "A near twin is the most tempting wrong answer here. If you need the opposite of happy, glad is a trap: it means the same.",
      "stems": [["hot", "cold"], ["full", "empty"], ["early", "late"], ["wet", "dry"], ["strong", "weak"], ["open", "shut"], ["rich", "poor"], ["push", "pull"], ["arrive", "leave"], ["ancient", "modern"]]
    },
    {
      "id": "kind", "rels": ["kind"], "title": "Kind of", "ic": "sprout",
      "idea": "Some pairs are a member and its group. A robin is a kind of bird. An oak is a kind of tree.",
      "bridge": "{A} is a kind of {B}.",
      "spot": "Say \"is a kind of\" between the two words. If it sounds right, you have found the link.",
      "trap": "Another member of the same group is a trap. For robin, sparrow tempts you, but a sparrow is not the group. And watch the direction: a bird is not a kind of robin.",
      "stems": [["robin", "bird"], ["oak", "tree"], ["rose", "flower"], ["carrot", "vegetable"], ["salmon", "fish"], ["hammer", "tool"], ["violin", "instrument"], ["truck", "vehicle"], ["circle", "shape"], ["ant", "insect"]]
    },
    {
      "id": "part", "rels": ["part"], "title": "Part of a whole", "ic": "puzzle",
      "idea": "Some pairs are a piece and the thing it belongs to. A petal is part of a flower. A page is part of a book.",
      "bridge": "{A} is part of {B}.",
      "spot": "Ask: could you find the first thing on or in the second? A wheel is on a bicycle.",
      "trap": "Another part of the same whole tempts you. For petal, stem is a trap: it is a part too, not the whole.",
      "stems": [["petal", "flower"], ["page", "book"], ["finger", "hand"], ["wing", "bird"], ["roof", "house"], ["fin", "fish"], ["branch", "tree"], ["sleeve", "shirt"], ["yolk", "egg"], ["string", "guitar"]]
    },
    {
      "id": "made", "rels": ["material"], "title": "Made from", "ic": "pot",
      "idea": "Some pairs are a thing and the stuff it is made from. A sweater is made from wool. A window is made from glass.",
      "bridge": "{A} is made from {B}.",
      "spot": "Ask: what would you need to make it? Bread needs flour.",
      "trap": "Something that goes with the thing is not what it is made from. Butter goes with bread, but bread is made from flour.",
      "stems": [["sweater", "wool"], ["window", "glass"], ["table", "wood"], ["candle", "wax"], ["bread", "flour"], ["tire", "rubber"], ["cheese", "milk"], ["brick", "clay"], ["snowman", "snow"], ["boot", "leather"]]
    },
    {
      "id": "use", "rels": ["function"], "title": "Used for", "ic": "tool",
      "idea": "Some pairs are a thing and the job it does. Scissors cut. A pen writes. A broom sweeps.",
      "bridge": "{A} is used to {B}.",
      "spot": "Say \"is used to\" between the words. A shovel is used to dig.",
      "trap": "Another thing from the same place is a trap. For broom, mop tempts you, but mop is a tool, not a job.",
      "stems": [["scissors", "cut"], ["pen", "write"], ["broom", "sweep"], ["shovel", "dig"], ["key", "unlock"], ["oven", "bake"], ["needle", "sew"], ["ladder", "climb"], ["scale", "weigh"], ["towel", "dry"]]
    },
    {
      "id": "who", "rels": ["agent"], "title": "Who does it", "ic": "user",
      "idea": "Some pairs are an action and the person who does it. Someone who bakes is a baker. Someone who sails is a sailor.",
      "bridge": "{B} is a person who {As}.",
      "spot": "Say \"a person who\" and the action. A person who paints is a painter.",
      "trap": "The thing the person works with is a trap. For bake, bread tempts you, but bread is what a baker makes, not who bakes.",
      "stems": [["bake", "baker"], ["teach", "teacher"], ["sail", "sailor"], ["paint", "painter"], ["farm", "farmer"], ["sing", "singer"], ["act", "actor"], ["drive", "driver"], ["swim", "swimmer"], ["invent", "inventor"]]
    },
    {
      "id": "family", "rels": ["action", "quality", "relating", "able"], "title": "Word families", "ic": "steps",
      "idea": "Some pairs keep the same idea and change the word's job. Decide becomes decision. Brave becomes bravery. Danger becomes dangerous.",
      "bridge": "{A} becomes {B}: the same idea with a new job.",
      "spot": "Look at the ending and the job. If the first pair turns an action into a thing, the second must too.",
      "trap": "A word with the same meaning but the wrong job is the trap. For kind to kindness, kindly tempts you, but kindly does a different job.",
      "stems": [["decide", "decision"], ["brave", "bravery"], ["danger", "dangerous"], ["explain", "explanation"], ["kind", "kindness"], ["joy", "joyful"], ["move", "movement"], ["dark", "darkness"], ["music", "musical"], ["enjoy", "enjoyment"]]
    },
    {
      "id": "degree", "rels": ["degree"], "title": "Stronger and weaker", "ic": "trend",
      "idea": "Some pairs are the same feeling or size, turned up. Warm turned up is hot. Hot turned up is scorching.",
      "bridge": "{B} is a stronger {A}.",
      "spot": "Ask: is the second word the same thing, only more so? Tired, then exhausted.",
      "trap": "A near twin at the SAME strength is the trap. Chilly is close to cool, but it is not the far end.",
      "stems": [["warm", "hot"], ["tired", "exhausted"], ["angry", "furious"], ["hungry", "starving"], ["cold", "freezing"], ["sad", "miserable"], ["dirty", "filthy"], ["wet", "soaked"], ["happy", "ecstatic"], ["small", "tiny"]]
    }
  ],
